# Static assets are served without running the Worker, so they get the same
# header set as SECURITY_HEADERS in src/index.js from here. No CSP: the OCR
# worker under /vendor/tesseract/ compiles WebAssembly.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
